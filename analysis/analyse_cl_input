from pathlib import Path
import pandas as pd
import sys

script_dir = Path(__file__).resolve().parent
project_dir = script_dir.parent
sys.path.insert(0, str(project_dir))
from helpers.input_file_selection import choose_file


project_dir = Path(__file__).parent
input_dir = project_dir / "input_raw"
output_dir = project_dir / "output_raw"

output_dir.mkdir(exist_ok=True)


def rank_protein_pairs(df: pd.DataFrame) -> pd.DataFrame:
    """
    Ranks protein pairs by their number of occurrences.

    Protein pairs are treated as unordered, so the order of the two
    protein IDs does not affect their ranking.

    :param df: DataFrame containing protein pair information.

    :return: DataFrame containing protein pairs and their occurrence counts.
    """
    required = {"Protein_id1", "Protein_id2"}
    missing = required - set(df.columns)

    if missing:
        raise ValueError(f"Missing column: {missing}")

    pairs = (
        df[["Protein_id1", "Protein_id2"]]
        .apply(lambda row: tuple(sorted(row)), axis=1)
    )

    ranking = (
        pairs.value_counts()
        .rename_axis("Protein_Pair")
        .reset_index(name="Count")
    )

    ranking[["Protein_id1", "Protein_id2"]] = pd.DataFrame(
        ranking["Protein_Pair"].tolist(),
        index=ranking.index,
    )

    ranking = ranking.drop(columns="Protein_Pair")

    return ranking[
        ["Protein_id1", "Protein_id2", "Count"]
    ]


def main():
    """
    Loads a selected CSV file, ranks protein pairs by occurrence,
    and exports the ranking to a CSV file.

    :return: None.
    """
    selected_file = choose_file(input_dir, ".csv")
    df = pd.read_csv(selected_file)

    ranking = rank_protein_pairs(df)
    print(ranking)

    output_file = output_dir / f"{selected_file.stem}_protein_pair_ranking.csv"
    ranking.to_csv(output_file, index=False)

    print(f"\nOutput file was written to: {output_file}")


if __name__ == "__main__":
    main()